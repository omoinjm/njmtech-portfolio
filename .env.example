# =============================================================================
# Infisical variable catalog (reference only — do NOT copy to .env.local)
# =============================================================================
# Secrets live in Infisical. Local dev: `pnpm init` once, then `pnpm dev`.
# Production (Vercel): same keys in the Vercel project env dashboard.
# This file documents names, purpose, and priority — keep in sync when adding vars.
#
# Priority:
#   P0 — app fails or core features break without these
#   P1 — production features (DB, AI chat, TTS)
#   P2 — nice-to-have / defaults exist in code
#   P3 — scripts & E2E only (Infisical dev env or CI)
# =============================================================================

# --- P0: Required -------------------------------------------------------------

# Public site URL (SEO, sitemap, Open Graph). Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://njmtech.co.za"

# Contact form + subscribe emails (server-only — never NEXT_PUBLIC_)
EMAIL_MAIL="your-email@example.com"
EMAIL_USER="your-email@example.com"
EMAIL_APP_PASS="your-app-specific-password"

# --- P1: Production data & AI -------------------------------------------------

# Cloudflare D1 — projects, skills, menu, Omoi voice cache lookups
D1_ACCOUNT_ID="your-cloudflare-account-id"
D1_DATABASE_ID="773865eb-1e3b-4ee3-9592-ffe658765d19"
D1_API_TOKEN="your-cloudflare-api-token"

# GitHub Models API — Omoi live chat (falls back to rule-based replies if unset)
GITHUB_TOKEN="your-github-pat-token"

# Hugging Face — VoxCPM TTS rate limits / auth
HF_TOKEN="your-huggingface-token"

# Omoi assistant voice (TTS / voice-cache generation)
VOXCPM_REF_AUDIO="https://example.com/omoi-voice-ref.wav"
VOXCPM_VOICE_INSTRUCTION="A young male voice with a clear but anxious and overthinking tone."

# --- P1: Blog (R2 + narration) ------------------------------------------------

# Public read URL for blog Markdown + index.json on R2
BLOG_STORAGE_BASE_URL="https://s3.njmtech.co.za/njmtech-portfolio/blog"

# Blog article TTS profile (separate from Omoi)
BLOG_VOXCPM_REF_AUDIO=""
BLOG_VOXCPM_VOICE_INSTRUCTION="A clear, calm male narrator. Steady pace, professional documentary tone."
BLOG_EDGE_TTS_VOICE="en-US-GuyNeural"

# --- P2: Public extras (defaults in code if unset) ----------------------------

NEXT_PUBLIC_RESUME_URL="https://example.com/resume.pdf"
NEXT_PUBLIC_MAILCHIMP_URL="https://your-list.list-manage.com/subscribe/post?..."
NEXT_PUBLIC_WS_CHAT_URL=""

# --- P3: Scripts only (wrangler / voice-cache / blog upload) ------------------

# Cloudflare Worker: Vercel → D1 project sync (wrangler secrets — not Next.js env)
# Set via: wrangler secret put VERCEL_TOKEN --config workers/vercel-project-sync/wrangler.jsonc
VERCEL_TOKEN="your-vercel-api-token"
VERCEL_TEAM_ID="your-vercel-team-id"
CRON_SECRET="optional-bearer-for-manual-post-sync"
SITE_URL="https://njmtech.co.za"

# GitHub Actions — repo secrets for auto-deploy (.github/workflows/deploy-vercel-sync-worker.yml)
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

R2_BUCKET_NAME="njmtech-blob"
BLOG_STORAGE_PREFIX="njmtech-portfolio/blog"
VOICE_CACHE_S3_BASE_URL="https://s3.njmtech.co.za/njmtech-portfolio/voice/omoi/samples"

# Playwright email tests
TEST_EMAIL=""
BASE_URL="http://localhost:3000"
TEMPLATE_API_URL="http://localhost:3001"
