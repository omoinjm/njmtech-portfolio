{
  "name": "njmtech-portfolio",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "init": "infisical init",
    "dev": "infisical run --env=dev --path=/ -- next dev --turbopack",
    "dev:local": "next dev --turbopack",
    "build:dev": "infisical run --env=dev -- next build",
    "build": "next build",
    "build:prod": "infisical run --env=prod -- next build",
    "start": "infisical run --env=prod -- next start",
    "start:local": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "prepare": "husky install",
    "pretty-quick": "pretty-quick --staged",
    "reset": "rm -rf node_modules/ pnpm-lock.yaml .next/",
    "test": "playwright test",
    "test:email": "playwright test email",
    "ai_cache": "infisical run -- npx tsx scripts/generate-voice-cache.ts",
    "voice-cache:test": "npx tsx scripts/test-voice-cache.ts",
    "voice-cache:test:d1": "infisical run -- npx tsx scripts/test-voice-cache.ts --d1",
    "blog:upload": "infisical run -- npx tsx scripts/upload-blog-to-r2.ts",
    "project:screenshots": "infisical run -- npx tsx scripts/capture-project-screenshots.ts",
    "omoi:spritesheet": "npx tsx scripts/build-omoi-spritesheet.ts",
    "sanity:seed": "npx tsx --env-file=.env.local scripts/seed-sanity.ts",
    "worker:sync:dev": "wrangler dev --config workers/vercel-project-sync/wrangler.jsonc --test-scheduled",
    "worker:sync:deploy": "wrangler deploy --config workers/vercel-project-sync/wrangler.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@gradio/client": "^2.8.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sanity/vision": "^6.24.0",
    "@sentry/nextjs": "^10.78.0",
    "@tanstack/react-query": "^5.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "edge-tts-universal": "^1.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.462.0",
    "ms": "^2.1.3",
    "next-intl": "^4.15.3",
    "next-sanity": "^13.5.1",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "sanity": "^6.24.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.2",
    "vaul": "^0.9.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@infisical/cli": "^0.43.145",
    "@playwright/test": "^1.65.1",
    "@sanity/client": "^8.17.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "pretty-quick": "^4.2.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.166.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "axios": ">=1.16.1",
      "follow-redirects": ">=1.16.0",
      "fast-xml-parser": ">=5.8.0",
      "postcss": ">=8.5.10",
      "js-yaml@3": "^3.15.2",
      "smol-toml@1": "^1.9.0",
      "sharp@<0.35.5": "^0.35.5",
      "postcss-selector-parser@6": "^6.1.5",
      "glob@13": "^14.0.2",
      "minimatch@10": "^11.0.1"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  }
}
